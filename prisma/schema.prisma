generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MatchStatus {
  ACTIVE
  FINISHED
}

model Player {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  avatarColor    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matchPlayers MatchPlayer[]
  scores       Score[]
}

model Match {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  endedAt     DateTime?
  target      Int         @default(66)
  notes       String?
  playerCount Int
  status      MatchStatus @default(ACTIVE)

  rounds       Round[]
  matchPlayers MatchPlayer[]
  scores       Score[]

  @@index([status, endedAt])
}

model MatchPlayer {
  id          String   @id @default(cuid())
  matchId     String
  playerId    String
  seat        Int
  displayName String
  createdAt   DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, seat])
  @@index([playerId])
}

model Round {
  id         String   @id @default(cuid())
  matchId    String
  roundIndex Int
  createdAt  DateTime @default(now())

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([matchId, roundIndex])
  @@index([matchId, roundIndex])
}

model Score {
  id        String   @id @default(cuid())
  roundId   String
  matchId   String
  playerId  String
  seat      Int
  points    Int?
  createdAt DateTime @default(now())

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([roundId, playerId])
  @@index([playerId, matchId])
  @@index([matchId])
}
